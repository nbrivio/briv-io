---
import { Image } from 'astro:assets';
import zeichen from '../assets/marke/briv-io-zeichen.png';
import { studio } from '../inhalt/studio.js';
import { pfad } from '../inhalt/pfad.js';

const { fest = false } = Astro.props;
---

<header class:list={['kopf', { fest }]}>
  <a class="kopf-marke" href={pfad('/')}>
    <Image class="zeichen" src={zeichen} alt={`${studio.name}, zur Startseite`} widths={[200, 400]} sizes="(max-width: 700px) 104px, 132px" loading="eager" />
  </a>
</header>
