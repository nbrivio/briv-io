---
import Marke from './Marke.astro';
import { studio } from '../inhalt/studio.js';
import { pfad } from '../inhalt/pfad.js';

const { fest = false } = Astro.props;
---

<header class:list={['kopf', { fest }]}>
  <a class="kopf-marke" href={pfad('/')}>
    <Marke />
    <span class="claim" lang="en">{studio.claim}.</span>
  </a>
</header>
