---
import '../stile/tokens.css';
import '../stile/grund.css';
import Kopf from '../components/Kopf.astro';
import Fuss from '../components/Fuss.astro';
import schriftTitel from '../assets/schriften/bricolage-grotesque-latin-wght-normal.woff2?url';
import schriftText from '../assets/schriften/instrument-sans-latin-wght-normal.woff2?url';
import { studio, anschrift } from '../inhalt/studio.js';
import { istLive } from '../inhalt/stufe.js';
import { pfad } from '../inhalt/pfad.js';

const { titel, beschreibung, start = false, intern = false, daten = [], pfad: brotkrumen = [] } = Astro.props;

if (beschreibung.length > 160) {
  throw new Error(`Beschreibung zu lang (${beschreibung.length} Zeichen): ${Astro.url.pathname}`);
}

const seitentitel = start ? titel : `${titel} | ${studio.name}`;
const adresse = new URL(Astro.url.pathname, Astro.site).href;
const anfang = new URL(pfad('/'), Astro.site).href;
const vorschau = new URL(pfad('/vorschau.jpg'), Astro.site).href;
const finden = istLive && !intern;

// Ein Block je Seite, dieselbe Kennung für dieselbe Sache auf allen Seiten.
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${anfang}#studio`,
      name: studio.name,
      slogan: studio.claim,
      description: `Unabhängiges Product Studio von ${studio.person} in der Schweiz.`,
      url: anfang,
      image: vorschau,
      founder: { '@id': `${anfang}#person` },
      ...(studio.email && { email: studio.email }),
      address: {
        '@type': 'PostalAddress',
        ...(anschrift && { streetAddress: anschrift.strasse, postalCode: anschrift.plz, addressLocality: anschrift.ort }),
        addressCountry: studio.land,
      },
    },
    {
      '@type': 'Person',
      '@id': `${anfang}#person`,
      name: studio.person,
      url: anfang,
      worksFor: { '@id': `${anfang}#studio` },
    },
    {
      '@type': 'WebSite',
      '@id': `${anfang}#website`,
      url: anfang,
      name: studio.name,
      inLanguage: 'de-CH',
      publisher: { '@id': `${anfang}#studio` },
    },
    {
      '@type': 'WebPage',
      '@id': `${adresse}#seite`,
      url: adresse,
      name: seitentitel,
      description: beschreibung,
      inLanguage: 'de-CH',
      isPartOf: { '@id': `${anfang}#website` },
      about: { '@id': `${anfang}#studio` },
      ...(brotkrumen.length > 0 && { breadcrumb: { '@id': `${adresse}#pfad` } }),
    },
    ...(brotkrumen.length > 0
      ? [
          {
            '@type': 'BreadcrumbList',
            '@id': `${adresse}#pfad`,
            itemListElement: [['Start', '/'], ...brotkrumen].map(([name, ziel], i) => ({
              '@type': 'ListItem',
              position: i + 1,
              name,
              item: new URL(pfad(ziel), Astro.site).href,
            })),
          },
        ]
      : []),
    ...daten,
  ],
};
---

<!doctype html>
<html lang="de-CH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{seitentitel}</title>
    <meta name="description" content={beschreibung} />
    <meta name="robots" content={finden ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={adresse} />
    <meta name="theme-color" content="#191f1b" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={pfad('/favicon.png')} type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href={pfad('/apple-touch-icon.png')} />
    <link rel="preload" href={schriftTitel} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={schriftText} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={studio.name} />
    <meta property="og:locale" content="de_CH" />
    <meta property="og:url" content={adresse} />
    <meta property="og:title" content={seitentitel} />
    <meta property="og:description" content={beschreibung} />
    <meta property="og:image" content={vorschau} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${studio.name}: die Wortmarke auf einem goldenen Band, getragen von zwei Schwalben, darunter «${studio.claim}»`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seitentitel} />
    <meta name="twitter:description" content={beschreibung} />
    <meta name="twitter:image" content={vorschau} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <a class="sprung" href="#inhalt">Zum Inhalt springen</a>
    <Kopf fest={start} />
    <main id="inhalt">
      <slot />
    </main>
    <Fuss />
  </body>
</html>

<script>
  import '../skripte/ausstellung.js';
</script>
