---
import '../stile/deck.css';
import { Image } from 'astro:assets';
import Seite from '../layouts/Seite.astro';
import { karten } from '../inhalt/karten.js';
import { studio } from '../inhalt/studio.js';
import { texte } from '../inhalt/texte.js';

const s = texte.start;
const anzahl = String(karten.length).padStart(2, '0');
---

<Seite start titel={s.seitentitel} beschreibung={s.beschreibung} farbe="#103f32">
  <section class="deck" aria-labelledby="deck-titel">
    <div class="tisch">
      <div class="leiste">
        <h1 id="deck-titel"><span>{studio.name}</span> <span lang="en">The Curiosity Deck</span></h1>
        <p class="wink" aria-hidden="true">Scrollen</p>
        <p class="stand" aria-hidden="true"><span data-stand>01</span> / {anzahl}</p>
      </div>
      <ol class="stapel">
        {
          karten.map((k, i) => (
            <li class="karte">
              {k.rueckseite ? (
                <div class="dreher">
                  <button type="button" class="vorn" aria-expanded="false" aria-controls={`rueck-${k.datei}`} aria-label={`${k.name}: Karte wenden`}>
                    <Image src={k.bild} alt={`${k.art === 'Satz' ? 'Karte' : `${k.art}karte`}: ${k.text}`} widths={[...new Set([320, 480, 720, 1086].map((b) => Math.min(b, k.bild.width)))]} sizes="(max-width: 700px) 62vw, 460px" quality={68} loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
                    <span class="pfeil" aria-hidden="true">↻</span>
                  </button>
                  <div class="hinten" id={`rueck-${k.datei}`}>
                    <p class="h-marke">Projekt <span>{k.kennung}</span></p>
                    <h2>{k.name}</h2>
                    <p class="h-was">{k.rueckseite.was}</p>
                    <p class="h-titel">Was ich gemacht habe</p>
                    <p class="h-gemacht">{k.rueckseite.gemacht}</p>
                    {k.rueckseite.stand && <p class="h-stand">{k.rueckseite.stand}</p>}
                    <p class="h-knoepfe">
                      {k.adresse && <a href={k.adresse} target="_blank" rel="noopener">Website von {k.name} öffnen</a>}
                      <button type="button" class="h-zurueck">Karte wenden</button>
                    </p>
                  </div>
                </div>
              ) : k.adresse ? (
                <a href={k.adresse} target="_blank" rel="noopener" aria-label={`Website von ${k.name} öffnen, in neuem Fenster`}>
                  <Image src={k.bild} alt={`${k.art === 'Satz' ? 'Karte' : `${k.art}karte`}: ${k.text}`} widths={[...new Set([320, 480, 720, 1086].map((b) => Math.min(b, k.bild.width)))]} sizes="(max-width: 700px) 62vw, 460px" quality={68} loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
                  <span class="pfeil" aria-hidden="true">↗</span>
                </a>
              ) : (
                <Image src={k.bild} alt={`${k.art === 'Satz' ? 'Karte' : `${k.art}karte`}: ${k.text}`} widths={[...new Set([320, 480, 720, 1086].map((b) => Math.min(b, k.bild.width)))]} sizes="(max-width: 700px) 62vw, 460px" quality={68} loading={i < 2 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
              )}
            </li>
          ))
        }
      </ol>
      <!-- Die Zugabe liegt nicht im Deck. Sie kommt erst, wenn jemand am Ende weiterscrollt. -->
      <div class="zugabe" lang="en" hidden>
        <p class="z-band">{studio.name}</p>
        <p class="z-marke">Bonus <span>B-01</span></p>
        <p class="z-zeichen" aria-hidden="true">∞</p>
        <p class="z-satz">Curiosity <em>rewarded</em></p>
        <p class="z-fuss">You kept going.</p>
      </div>
    </div>
  </section>
</Seite>
