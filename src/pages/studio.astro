---
import '../stile/blatt.css';
import Seite from '../layouts/Seite.astro';
import { studio } from '../inhalt/studio.js';
import Betont from '../components/Betont.astro';
import { texte } from '../inhalt/texte.js';
import { pfad } from '../inhalt/pfad.js';

const s = texte.studio;
---

<Seite titel={s.seitentitel} beschreibung={s.beschreibung} pfad={[['Studio', '/studio/']]}>
  <header class="tafel schlicht">
    <p class="etikett">Studio</p>
    <h1 class="satz"><Betont text={s.titel} /></h1>
    <p class="lead">{s.lead}</p>
  </header>

  <div class="bogen zwei">
    <div class="teil">
      {s.teile.map((teil) => (<><h2>{teil.titel}</h2>{teil.text.map((absatz) => <p>{absatz}</p>)}</>))}
    </div>
    <div class="teil">
      <h2 class="gross"><Betont text={s.tuerTitel} /></h2>
      <p>{s.tuerText}</p>
      <p class="leitsatz" lang="en">{s.leitsatz}</p>
      {studio.email && <p><a class="weiter" href={`mailto:${studio.email}`}>Mail an {studio.person}</a></p>}
      <p><a class="weiter" href={pfad('/')}>Zur Ausstellung</a></p>
    </div>
  </div>
</Seite>
